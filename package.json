{
  "name": "ht-english-library",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check:catalog": "node tools/check-catalog.mjs",
    "test:prepare": "node --test tests/catalog.test.mjs tests/preflight.test.mjs",
    "preflight:firebase": "node tools/firebase-preflight.mjs",
    "prepare:rollback": "node tools/prepare-firebase-rollback.mjs",
    "test:rules": "node --test tests/firestore-rules.test.mjs",
    "test:emulators": "firebase emulators:exec --project demo-ht-english-library --only auth,firestore 'npm run test:rules && python3 tests/auth-browser.py'"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.33.0",
    "google-auth-library": "9.15.1"
  }
}
